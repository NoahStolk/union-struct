<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0"/>
    <PackageReference Include="xunit.v3" Version="3.2.2"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup>
    <!--
    The PrivateAssets/IncludeAssets below are exactly what NuGet writes when you run `dotnet add package` against a
    package marked as a development dependency - note the absence of "compile". Keep it that way: this is what verifies
    that a default install works without the consumer having to hand-edit the PackageReference.
    -->
    <PackageReference Include="NoahStolk.UnionStruct" Version="0.0.0-temp">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\UnionStruct.Tests.Integration\**\*.cs" Link="%(Filename)%(Extension)"/>
  </ItemGroup>

</Project>
