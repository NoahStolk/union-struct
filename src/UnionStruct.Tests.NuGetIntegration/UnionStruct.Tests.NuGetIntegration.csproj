<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="TUnit"/>
  </ItemGroup>

  <ItemGroup>
    <!--
    VersionOverride, not Version: central package management (Directory.Packages.props) applies to this
    project too, and the version here is the temp one produced by `dotnet pack` for integration testing.
    -->
    <!--
    The PrivateAssets/IncludeAssets below are exactly what NuGet writes when you run `dotnet add package` against a
    package marked as a development dependency - note the absence of "compile". Keep it that way: this is what verifies
    that a default install works without the consumer having to hand-edit the PackageReference.
    -->
    <PackageReference Include="NoahStolk.UnionStruct" VersionOverride="0.0.0-temp">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\UnionStruct.Tests.Integration\**\*.cs" Link="%(Filename)%(Extension)"/>
  </ItemGroup>

</Project>
