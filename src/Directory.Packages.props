<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="Current">

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0"/>

		<!--
		Do not upgrade: this is the minimum Roslyn version every consumer of the generated package must have.
		Building against a Roslyn newer than the host compiler makes csc skip the generator (CS9057).
		-->
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0"/>
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0"/>
	</ItemGroup>

	<ItemGroup Label="Test dependencies">
		<!--
		TUnit runs on Microsoft.Testing.Platform, not VSTest. Do not add Microsoft.NET.Test.Sdk or coverlet.*
		back in - they pull in the VSTest host and stop TUnit's test discovery from working.
		-->
		<PackageVersion Include="TUnit" Version="1.67.0"/>
		<PackageVersion Include="Verify.SourceGenerators" Version="2.5.0"/>
		<PackageVersion Include="Verify.TUnit" Version="33.0.2"/>
	</ItemGroup>

	<ItemGroup Label="Static code analysis">
		<GlobalPackageReference Include="Nullable.Extended.Analyzer" Version="1.16.6891"/>
		<GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.0"/>
		<GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.34.0.3385"/>
		<GlobalPackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556"/>
	</ItemGroup>

</Project>
