<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="Current">

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0"/>

		<!--
		The generator's own reference. Do not raise it past the compiler of the oldest supported SDK (11.0.100 ships
		Roslyn 5.12): building against a Roslyn newer than the host compiler makes csc skip the generator (CS9057).
		Keeping it low also keeps older IDE-hosted compilers able to load the generator.
		-->
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0"/>

		<!--
		Test-only. The snapshot tests build their own compilations, which must parse C# 14 partial constructors and
		C# 15 unions, so this has to be at least the Roslyn that ships with SDK 11.0.100.
		-->
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0"/>
	</ItemGroup>

	<ItemGroup Label="Test dependencies">
		<!--
		TUnit runs on Microsoft.Testing.Platform, not VSTest. Do not add Microsoft.NET.Test.Sdk or coverlet.*
		back in - they pull in the VSTest host and stop TUnit's test discovery from working.
		-->
		<PackageVersion Include="TUnit" Version="1.86.6"/>
		<PackageVersion Include="Verify.SourceGenerators" Version="2.5.0"/>
		<PackageVersion Include="Verify.TUnit" Version="33.0.2"/>
	</ItemGroup>

	<ItemGroup Label="Static code analysis">
		<GlobalPackageReference Include="Nullable.Extended.Analyzer" Version="1.19.0"/>
		<GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1"/>
		<GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.36.0.15337"/>
		<GlobalPackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556"/>
	</ItemGroup>

</Project>
