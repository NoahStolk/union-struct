<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>

    <!--
    No GeneratePackageOnBuild: with it, the Pack target skips Build (it assumes the build already packed), so `dotnet pack`
    would ship whatever UnionStruct.dll an earlier build left in $(OutputPath), or fail with NU5019 on a clean tree.
    -->

    <!-- This project exists only to produce the NuGet; its own (empty) assembly must not end up in lib/. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!-- Analyzer-only package: no lib/ folder, so the (empty) netstandard2.0 dependency group would only trigger NU5128. -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <PropertyGroup Label="Package configuration">
    <PackageId>NoahStolk.UnionStruct</PackageId>
    <Version>0.5.0</Version>
    <Authors>Noah Stolk</Authors>
    <Copyright>Copyright © Noah Stolk</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/NoahStolk/UnionStruct</RepositoryUrl>
    <PackageProjectUrl>https://github.com/NoahStolk/UnionStruct</PackageProjectUrl>
    <Description>UnionStruct is a C# source generator that implements memory-efficient, allocation-free C# 15 union structs.</Description>
    <PackageTags>discriminated unions, source generator</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <!--
  The package ships nothing but the source generator. The attributes are emitted into the consuming
  compilation by the generator, so there is no lib/ folder and therefore no need for consumers to include the "compile"
  asset - the IncludeAssets list NuGet writes for a development dependency (which omits "compile") is correct as-is.
  -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false"/>
    <None Include="$(OutputPath)\UnionStruct.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnionStruct\UnionStruct.csproj" PrivateAssets="all"/>
  </ItemGroup>

</Project>
